    "argon2": "0.44.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.5.4",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.439.0",
    "next": "15.5.24",
    "next-auth": "^5.0.0-beta.20",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^2.5.2",
    "uuid": "^14.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.4.45",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.11",
    "tsx": "4.20.6",
    "typescript": "^5.6.2",
    "vitest": "4.1.11",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
