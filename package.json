{
  "name": "smarto",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean.js",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
