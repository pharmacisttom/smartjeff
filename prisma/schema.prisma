generator client {
  provider = "prisma-client-js"
}

model PayrollPeriod {
  id          String       @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  month       Int
  year        Int
  status      String       @default("DRAFT")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payrollRuns PayrollRun[]

  @@unique([startDate, endDate])
  @@index([year, month])
}

model PayrollComponent {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  name               String
  type               String
  calculationType    String
  rate               Decimal?                 @db.Decimal(18, 4)
  multiplier         Decimal?                 @db.Decimal(10, 4)
  taxable            Boolean                  @default(false)
  socialSecurityBase Boolean                  @default(false)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  policies           PayrollPolicyComponent[]
}

model PayrollPolicy {
  id            String                   @id @default(cuid())
  code          String                   @unique
  name          String
  status        String                   @default("DRAFT")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  components    PayrollPolicyComponent[]
  sites         SitePayrollPolicy[]
}

model PayrollPolicyComponent {
  id          String           @id @default(cuid())
  policyId    String
  policy      PayrollPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  componentId String
  component   PayrollComponent @relation(fields: [componentId], references: [id])
  config      Json?
  isActive    Boolean          @default(true)

  @@unique([policyId, componentId])
}

model SitePayrollPolicy {
  id        String        @id @default(cuid())
  siteId    String
  site      Site          @relation(fields: [siteId], references: [id])
  policyId  String
  policy    PayrollPolicy @relation(fields: [policyId], references: [id])
  startDate DateTime
  endDate   DateTime?

  @@unique([siteId, policyId, startDate])
  @@index([siteId, startDate])
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                 String               @id @default(cuid())
  code               String               @unique
  prefix             String?
  firstName          String
  lastName           String
  position           String
  siteId             String
  site               Site                 @relation(fields: [siteId], references: [id])
  startDate          DateTime?
  birthDate          DateTime?
  gender             String               @default("MALE")
  nationality        String               @default("Thai")
  idCardNo           String?              @unique
  phone              String?
  bankAccount        String?
  bankName           String?
  insurance          String?
  hospital           String?
  education          String?
  hometown           String?
  salaryType         String               @default("MONTHLY")
  baseSalary         Decimal              @default(12000) @db.Decimal(18, 2)
  dailyRate          Decimal              @default(400) @db.Decimal(18, 2)
  isActive           Boolean              @default(true)
  employmentStatus   String               @default("ACTIVE")
  preferredLanguage  String               @default("th")
  departmentId       String?
  department         Department?          @relation(fields: [departmentId], references: [id])
  user               User?
  attendances        Attendance[]
  leaves             Leave[]
  payslips           Payslip[]
  chats              ChatMessage[]
  shiftAssignments   ShiftAssignment[]
  assignedWorkOrders WorkOrder[]
  drivenTrips        Trip[]               @relation("TripDriver")
  deployments        EmployeeDeployment[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([siteId])
  @@index([code])
  @@index([departmentId])
}

model Site {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  shortName            String?
  clientId             String?
  client               Client?               @relation(fields: [clientId], references: [id])
  status               String                @default("ACTIVE")
  location             String?
  estateName           String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  lat                  Float?
  lng                  Float?
  radius               Int                   @default(200)
  workStart            Float                 @default(7)
  workEnd              Float                 @default(16)
  otStart              Float?                @default(16)
  otEnd                Float?                @default(17)
  employees            Employee[]
  shiftAssignments     ShiftAssignment[]
  config               PayrollConfig?
  shiftTemplates       ShiftTemplate[]
  payrollPolicies      SitePayrollPolicy[]
  deployments          EmployeeDeployment[]
  inventoryOperations  InventoryOperation[]
  materialRequisitions MaterialRequisition[]
  materialWarehouses   Warehouse[]
  createdAt            DateTime              @default(now())

  @@index([clientId])
}

model Attendance {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  localId          String?   @unique
  type             String
  timestamp        DateTime  @default(now())
  lat              Float
  lng              Float
  distance         Float
  accuracy         Float?
  isWithinGeofence Boolean   @default(false)
  photoUrl         String?
  photoHash        String?
  deviceInfo       String?
  note             String?
  isApproved       Boolean   @default(false)
  approvalStatus   String    @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@index([approvalStatus, timestamp])
  @@index([localId])
}

model Leave {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String    @default("PENDING")
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, status])
}

model Payslip {
  id            String      @id @default(cuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRunId  String?
  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id])
  period        String // "2026-09"
  baseSalary    Decimal     @db.Decimal(18, 2)
  dailyRate     Decimal?    @default(0) @db.Decimal(18, 2)
  workedDays    Int?        @default(0)
  dailyAmount   Decimal?    @default(0) @db.Decimal(18, 2)
  otHours       Float       @default(0)
  otAmount      Decimal     @default(0) @db.Decimal(18, 2)
  ot1Hours      Float?      @default(0)
  ot1Amount     Decimal?    @default(0) @db.Decimal(18, 2)
  ot15Hours     Float?      @default(0)
  ot15Amount    Decimal?    @default(0) @db.Decimal(18, 2)
  ot2Hours      Float?      @default(0)
  ot2Amount     Decimal?    @default(0) @db.Decimal(18, 2)
  ot3Hours      Float?      @default(0)
  ot3Amount     Decimal?    @default(0) @db.Decimal(18, 2)
  travelAllow   Decimal     @default(0) @db.Decimal(18, 2)
  diligence     Decimal     @default(0) @db.Decimal(18, 2)
  mealAllow     Decimal?    @default(0) @db.Decimal(18, 2)
  otMealAllow   Decimal?    @default(0) @db.Decimal(18, 2)
  heatAllow     Decimal?    @default(0) @db.Decimal(18, 2)
  dishwashAllow Decimal?    @default(0) @db.Decimal(18, 2)
  skillAllow    Decimal?    @default(0) @db.Decimal(18, 2)
  incentive     Decimal?    @default(0) @db.Decimal(18, 2)
  shiftAllow    Decimal?    @default(0) @db.Decimal(18, 2)
  phoneAllow    Decimal?    @default(0) @db.Decimal(18, 2)
  positionAllow Decimal?    @default(0) @db.Decimal(18, 2)
  housingAllow  Decimal?    @default(0) @db.Decimal(18, 2)
  coordAllow    Decimal?    @default(0) @db.Decimal(18, 2)
  holidayPay    Decimal?    @default(0) @db.Decimal(18, 2)
  leavePay      Decimal?    @default(0) @db.Decimal(18, 2)
  otherIncome   Decimal     @default(0) @db.Decimal(18, 2)
  grossIncome   Decimal?    @default(0) @db.Decimal(18, 2)
  tax           Decimal     @default(0) @db.Decimal(18, 2)
  socialSec     Decimal     @default(0) @db.Decimal(18, 2)
  welfareDeduct Decimal?    @default(0) @db.Decimal(18, 2)
  otherDeduct   Decimal     @default(0) @db.Decimal(18, 2)
  totalDeduct   Decimal?    @default(0) @db.Decimal(18, 2)
  netPay        Decimal     @db.Decimal(18, 2)
  pdfUrl        String?
  itemizedJson  String?
  createdAt     DateTime    @default(now())

  @@unique([employeeId, period])
  @@index([period])
  @@index([payrollRunId])
}

model PayrollConfig {
  id                  String    @id @default(cuid())
  siteId              String?   @unique
  site                Site?     @relation(fields: [siteId], references: [id])
  otRate              Decimal   @default(75) @db.Decimal(18, 2)
  travelAllowance     Decimal   @default(0) @db.Decimal(18, 2)
  diligenceAmount     Decimal   @default(1000) @db.Decimal(18, 2)
  diligenceMaxLate    Int       @default(3)
  workingDaysPerMonth Int       @default(26)
  workingHoursPerDay  Int       @default(8)
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?
}

model ChatMessage {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String
  content     String
  attachments String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

model User {
  id                           String                    @id @default(cuid())
  email                        String                    @unique
  passwordHash                 String?
  role                         String                    @default("EMPLOYEE")
  permissions                  String?                   @db.Text
  assignedSiteCode             String?
  type                         String                    @default("INTERNAL")
  displayName                  String?
  phone                        String?
  avatar                       String?
  lineUserId                   String?                   @unique
  image                        String?
  locale                       String                    @default("th")
  isActive                     Boolean                   @default(true)
  isLocked                     Boolean                   @default(false)
  lockedAt                     DateTime?
  mfaEnabled                   Boolean                   @default(false)
  mfaSecret                    String?
  activationPinHash            String?
  activationPinExpiresAt       DateTime?
  activationPinUsedAt          DateTime?
  activationPinAttempts        Int                       @default(0)
  lastLoginAt                  DateTime?
  lastLoginIp                  String?
  mustChangePassword           Boolean                   @default(false)
  authMethod                   String                    @default("LOCAL")
  passwordChangedAt            DateTime?
  passwordExpiresAt            DateTime?
  lastPasswordReminderAt       DateTime?
  employeeId                   String?                   @unique
  employee                     Employee?                 @relation(fields: [employeeId], references: [id])
  authzVersion                 Int                       @default(1)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  deletedAt                    DateTime?
  recoveryCodes                MfaRecoveryCode[]
  roleAssignments              UserRoleAssignment[]
  sessions                     UserSession[]
  accessRequests               AccessRequest[]
  passwordHistory              PasswordHistory[]
  demoAccounts                 DemoAccount[]             @relation("DemoAccountUser")
  updatedDemoAccounts          DemoAccount[]             @relation("DemoAccountUpdater")
  inventoryOperations          InventoryOperation[]
  createdMaterialRequisitions  MaterialRequisition[]     @relation("MaterialRequester")
  approvedMaterialRequisitions MaterialRequisition[]     @relation("MaterialApprover")
  createdStockTransfers        StockTransfer[]           @relation("TransferCreator")
  approvedStockTransfers       StockTransfer[]           @relation("TransferApprover")
  createdStockAdjustments      StockAdjustment[]         @relation("AdjustmentCreator")
  approvedStockAdjustments     StockAdjustment[]         @relation("AdjustmentApprover")
  inventoryAcknowledgements    MaterialAcknowledgement[]

  @@index([email])
  @@index([isActive])
}

model DemoAccount {
  id        String   @id @default(cuid())
  demoRole  String   @unique
  userId    String
  user      User     @relation("DemoAccountUser", fields: [userId], references: [id], onDelete: Restrict)
  isEnabled Boolean  @default(true)
  label     String?
  sortOrder Int      @default(0)
  updatedBy String?
  updater   User?    @relation("DemoAccountUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedBy])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Role {
  id              String               @id @default(cuid())
  code            String               @unique
  nameTh          String
  nameEn          String
  description     String?              @db.Text
  level           Int                  @default(1)
  departmentType  String?
  isSystem        Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]
  authorities     ApprovalAuthority[]

  @@index([code])
  @@index([isActive])
  @@map("role")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  action      String
  description String?          @db.Text
  sensitivity String           @default("NORMAL")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([code])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("rolepermission")
}

model UserRoleAssignment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType  String    @default("GLOBAL")
  scopeId    String?
  startAt    DateTime?
  endAt      DateTime?
  assignedBy String?
  reason     String?   @db.Text
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
  @@index([roleId])
  @@index([scopeType, scopeId])
}

model ApprovalAuthority {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  action    String
  level     String
  minAmount Decimal? @default(0) @db.Decimal(18, 2)
  maxAmount Decimal? @db.Decimal(18, 2)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([roleId, module])
  @@map("approvalauthority")
}

model UserSession {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String?
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?  @db.Text
  status       String   @default("ACTIVE")
  authStrength String   @default("PASSWORD")
  authzVersion Int      @default(1)
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId, status])
  @@index([sessionId])
}

model AccessRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRoleId   String?
  permissionCode String?
  scopeType      String?
  scopeId        String?
  reason         String    @db.Text
  durationDays   Int?      @default(30)
  status         String    @default("PENDING")
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@map("accessrequest")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model ImportJob {
  id           String    @id @default(cuid())
  fileName     String
  fileHash     String
  importType   String
  status       String    @default("UPLOADED")
  uploadedById String
  totalRows    Int       @default(0)
  validRows    Int       @default(0)
  invalidRows  Int       @default(0)
  createdRows  Int       @default(0)
  updatedRows  Int       @default(0)
  skippedRows  Int       @default(0)
  errorRows    Int       @default(0)
  mapping      Json?
  report       Json?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([fileHash, importType])
  @@index([uploadedById, createdAt])
  @@index([status, createdAt])
}

model Organization {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  nameTh               String?
  taxId                String?
  address              String?
  phone                String?
  email                String?
  logo                 String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  materialCategories   MaterialCategory[]
  materials            Material[]
  warehouses           Warehouse[]
  inventoryOperations  InventoryOperation[]
  materialRequisitions MaterialRequisition[]
  stockTransfers       StockTransfer[]
  stockAdjustments     StockAdjustment[]
  materialReceipts     GoodsReceipt[]
}

model Department {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  nameTh    String?
  parentId  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model CostCenter {
  id                 String               @id @default(cuid())
  code               String               @unique
  name               String
  nameTh             String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  InventoryOperation InventoryOperation[]
}

model ShiftTemplate {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  siteId        String?
  site          Site?             @relation(fields: [siteId], references: [id])
  positionType  String?
  type          String            @default("DAY")
  startTime     String
  endTime       String
  otStartTime   String?
  otEndTime     String?
  crossMidnight Boolean           @default(false)
  breakMinutes  Int               @default(60)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  assignments   ShiftAssignment[]

  @@index([siteId, isActive])
}

model ShiftAssignment {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  siteId          String?
  site            Site?          @relation(fields: [siteId], references: [id])
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  date            DateTime
  startTime       String?
  endTime         String?
  shiftType       String         @default("DAY") // "DAY", "OT", "OFF", "LEAVE", "RELIEF"
  workHours       Float          @default(8)
  otHours         Float          @default(0)
  isRelief        Boolean        @default(false)
  homeSiteId      String?
  note            String?
  isPublished     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([siteId, date])
}

model PayrollRun {
  id              String         @id @default(cuid())
  period          String
  siteId          String?
  status          String         @default("DRAFT")
  totalAmount     Decimal        @default(0) @db.Decimal(18, 2)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  payslips        Payslip[]
  payrollPeriodId String?
  payrollPeriod   PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])

  @@unique([period, siteId])
  @@index([payrollPeriodId])
}

model Client {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  nameTh        String?
  taxId         String?
  address       String?
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  industry      String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  projects      Project[]
  contracts     Contract[]
  invoices      Invoice[]
  opportunities Opportunity[]
  contacts      ClientContact[]
  sites         Site[]
}

model ClientContact {
  id                  String               @id @default(cuid())
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  position            String?
  email               String?
  phone               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inventoryOperations InventoryOperation[]

  @@index([clientId])
}

model EmployeeDeployment {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  effectiveDate DateTime
  position      String
  supervisorId  String?
  documentRefs  Json?
  status        String    @default("PENDING")
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, siteId, effectiveDate])
  @@index([siteId, effectiveDate])
  @@index([status, effectiveDate])
}

model Opportunity {
  id             String         @id @default(cuid())
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  title          String
  description    String?
  stage          String         @default("LEAD")
  estimatedValue Decimal?       @db.Decimal(18, 2)
  probability    Int?           @default(50)
  expectedClose  DateTime?
  assignedTo     String?
  lostReason     String?
  projectId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenders        Tender[]
  quotations     Quotation[]
  estimates      CostEstimate[]

  @@index([stage])
}

model Tender {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  refNo         String?      @unique
  title         String
  issueDate     DateTime?
  dueDate       DateTime?
  budget        Decimal?     @db.Decimal(18, 2)
  status        String       @default("OPEN")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model CostEstimate {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  version       Int          @default(1)
  name          String
  laborCost     Decimal      @default(0) @db.Decimal(18, 2)
  materialCost  Decimal      @default(0) @db.Decimal(18, 2)
  fleetCost     Decimal      @default(0) @db.Decimal(18, 2)
  overhead      Decimal      @default(0) @db.Decimal(18, 2)
  margin        Decimal      @default(0) @db.Decimal(18, 2)
  totalCost     Decimal      @default(0) @db.Decimal(18, 2)
  sellPrice     Decimal      @default(0) @db.Decimal(18, 2)
  isApproved    Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model Quotation {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  refNo         String?      @unique
  version       Int          @default(1)
  title         String
  totalAmount   Decimal      @db.Decimal(18, 2)
  currency      String       @default("THB")
  validUntil    DateTime?
  status        String       @default("DRAFT")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Project {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  nameTh               String?
  clientId             String?
