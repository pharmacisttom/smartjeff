generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                 String            @id @default(cuid())
  code               String            @unique
  prefix             String?
  firstName          String
  lastName           String
  position           String
  siteId             String
  site               Site              @relation(fields: [siteId], references: [id])
  startDate          DateTime?
  birthDate          DateTime?
  gender             String            @default("MALE")
  nationality        String            @default("Thai")
  idCardNo           String?           @unique
  phone              String?
  bankAccount        String?
  bankName           String?
  insurance          String?
  hospital           String?
  education          String?
  hometown           String?
  salaryType         String            @default("MONTHLY")
  baseSalary         Decimal           @default(12000) @db.Decimal(18, 2)
  dailyRate          Decimal           @default(400) @db.Decimal(18, 2)
  isActive           Boolean           @default(true)
  user               User?
  attendances        Attendance[]
  leaves             Leave[]
  payslips           Payslip[]
  chats              ChatMessage[]
  shiftAssignments   ShiftAssignment[]
  assignedWorkOrders WorkOrder[]
  drivenTrips        Trip[]            @relation("TripDriver")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([siteId])
  @@index([code])
}

model Site {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  location  String?
  lat       Float?
  lng       Float?
  radius    Int            @default(200)
  workStart Float          @default(7)
  workEnd   Float          @default(16)
  otStart   Float?         @default(16)
  otEnd     Float?         @default(17)
  employees Employee[]
  config    PayrollConfig?
  createdAt DateTime       @default(now())
}

model Attendance {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  localId          String?   @unique
  type             String
  timestamp        DateTime  @default(now())
  lat              Float
  lng              Float
  distance         Float
  accuracy         Float?
  isWithinGeofence Boolean   @default(false)
  photoUrl         String?
  photoHash        String?
  deviceInfo       String?
  note             String?
  isApproved       Boolean   @default(false)
  approvalStatus   String    @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@index([approvalStatus, timestamp])
  @@index([localId])
}

model Leave {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String    @default("PENDING")
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, status])
}

model Payslip {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRunId String?
  payrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id])
  period       String
  baseSalary   Decimal     @db.Decimal(18, 2)
  otHours      Float       @default(0)
  otAmount     Decimal     @default(0) @db.Decimal(18, 2)
  travelAllow  Decimal     @default(0) @db.Decimal(18, 2)
  diligence    Decimal     @default(0) @db.Decimal(18, 2)
  otherIncome  Decimal     @default(0) @db.Decimal(18, 2)
  tax          Decimal     @default(0) @db.Decimal(18, 2)
  socialSec    Decimal     @default(0) @db.Decimal(18, 2)
  otherDeduct  Decimal     @default(0) @db.Decimal(18, 2)
  netPay       Decimal     @db.Decimal(18, 2)
  pdfUrl       String?
  createdAt    DateTime    @default(now())

  @@unique([employeeId, period])
  @@index([period])
  @@index([payrollRunId])
}

model PayrollConfig {
  id                  String    @id @default(cuid())
  siteId              String?   @unique
  site                Site?     @relation(fields: [siteId], references: [id])
  otRate              Decimal   @default(75) @db.Decimal(18, 2)
  travelAllowance     Decimal   @default(0) @db.Decimal(18, 2)
  diligenceAmount     Decimal   @default(1000) @db.Decimal(18, 2)
  diligenceMaxLate    Int       @default(3)
  workingDaysPerMonth Int       @default(26)
  workingHoursPerDay  Int       @default(8)
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?
}

model ChatMessage {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String
  content     String
  attachments String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  passwordHash       String?
  role               String            @default("EMPLOYEE")
  type               String            @default("INTERNAL")
  displayName        String?
  phone              String?
  avatar             String?
  lineUserId         String?           @unique
  image              String?
  locale             String            @default("th")
  isActive           Boolean           @default(true)
  isLocked           Boolean           @default(false)
  lockedAt           DateTime?
  mfaEnabled         Boolean           @default(false)
  mfaSecret          String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  mustChangePassword Boolean           @default(false)
  employeeId         String?           @unique
  employee           Employee?         @relation(fields: [employeeId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  recoveryCodes      MfaRecoveryCode[]

  @@index([email])
  @@index([isActive])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model Organization {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameTh    String?
  taxId     String?
  address   String?
  phone     String?
  email     String?
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameTh    String?
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CostCenter {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameTh    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ShiftTemplate {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  type         String            @default("DAY")
  startTime    String
  endTime      String
  breakMinutes Int               @default(60)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  date            DateTime
  startTime       String?
  endTime         String?
  note            String?
  isPublished     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model PayrollRun {
  id           String    @id @default(cuid())
  period       String
  siteId       String?
  status       String    @default("DRAFT")
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payslips     Payslip[]

  @@unique([period, siteId])
}

model Client {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  nameTh        String?
  taxId         String?
  address       String?
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  industry      String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  projects      Project[]
  contracts     Contract[]
  invoices      Invoice[]
  opportunities Opportunity[]
}

model Opportunity {
  id             String         @id @default(cuid())
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  title          String
  description    String?
  stage          String         @default("LEAD")
  estimatedValue Decimal?       @db.Decimal(18, 2)
  probability    Int?           @default(50)
  expectedClose  DateTime?
  assignedTo     String?
  lostReason     String?
  projectId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenders        Tender[]
  quotations     Quotation[]
  estimates      CostEstimate[]

  @@index([stage])
}

model Tender {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  refNo         String?      @unique
  title         String
  issueDate     DateTime?
  dueDate       DateTime?
  budget        Decimal?     @db.Decimal(18, 2)
  status        String       @default("OPEN")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model CostEstimate {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  version       Int          @default(1)
  name          String
  laborCost     Decimal      @default(0) @db.Decimal(18, 2)
  materialCost  Decimal      @default(0) @db.Decimal(18, 2)
  fleetCost     Decimal      @default(0) @db.Decimal(18, 2)
  overhead      Decimal      @default(0) @db.Decimal(18, 2)
  margin        Decimal      @default(0) @db.Decimal(18, 2)
  totalCost     Decimal      @default(0) @db.Decimal(18, 2)
  sellPrice     Decimal      @default(0) @db.Decimal(18, 2)
  isApproved    Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model Quotation {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  refNo         String?      @unique
  version       Int          @default(1)
  title         String
  totalAmount   Decimal      @db.Decimal(18, 2)
  currency      String       @default("THB")
  validUntil    DateTime?
  status        String       @default("DRAFT")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Project {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String
  nameTh        String?
  clientId      String?
  client        Client?            @relation(fields: [clientId], references: [id])
  status        String             @default("PLANNING")
  managerId     String?
  startDate     DateTime?
  endDate       DateTime?
  completedAt   DateTime?
  description   String?
  budgetAmount  Decimal            @default(0) @db.Decimal(18, 2)
  actualCost    Decimal            @default(0) @db.Decimal(18, 2)
  committedCost Decimal            @default(0) @db.Decimal(18, 2)
  forecastCost  Decimal            @default(0) @db.Decimal(18, 2)
  revenueAmount Decimal            @default(0) @db.Decimal(18, 2)
  margin        Decimal            @default(0) @db.Decimal(18, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  contract      Contract?
  milestones    ProjectMilestone[]
  workOrders    WorkOrder[]
  costs         ProjectCost[]
  invoices      Invoice[]

  @@index([status])
  @@index([clientId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  completedAt DateTime?
  amount      Decimal?  @db.Decimal(18, 2)
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

model Contract {
  id          String    @id @default(cuid())
  projectId   String?   @unique
  project     Project?  @relation(fields: [projectId], references: [id])
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  refNo       String?   @unique
  type        String    @default("FIXED_PRICE")
  status      String    @default("DRAFT")
  title       String
  value       Decimal   @db.Decimal(18, 2)
  currency    String    @default("THB")
  startDate   DateTime?
  endDate     DateTime?
  signedAt    DateTime?
  version     Int       @default(1)
  documentUrl String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WorkOrder {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  assigneeId   String?
  assignee     Employee? @relation(fields: [assigneeId], references: [id])
  refNo        String?   @unique
  title        String
  description  String?
  type         String    @default("GENERAL")
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  dueAt        DateTime?
  estimatedHrs Float?
  actualHrs    Float?
  laborCost    Decimal?  @db.Decimal(18, 2)
  materialCost Decimal?  @db.Decimal(18, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
}

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  type        String
  sourceId    String?
  sourceType  String?
  description String
  amount      Decimal  @db.Decimal(18, 2)
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([projectId, type])
}

model Vehicle {
  id            String               @id @default(cuid())
  code          String               @unique
  plateNo       String               @unique
  type          String
  brand         String?
  model         String?
  year          Int?
  color         String?
  status        String               @default("AVAILABLE")
  odometer      Float                @default(0)
  fuelType      String               @default("DIESEL")
  insuranceExp  DateTime?
  inspectionExp DateTime?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  trips         Trip[]
  maintenances  VehicleMaintenance[]
  fuelRecords   FuelRecord[]

  @@index([status])
}

model Trip {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  driverId      String?
  driver        Employee? @relation("TripDriver", fields: [driverId], references: [id])
  projectId     String?
  refNo         String?   @unique
  purpose       String
  origin        String?
  destination   String?
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  status        String    @default("PLANNED")
  odometerStart Float?
  odometerEnd   Float?
  distanceKm    Float?
  fuelUsed      Float?
  fuelCost      Decimal?  @db.Decimal(18, 2)
  tollCost      Decimal?  @db.Decimal(18, 2)
  totalCost     Decimal?  @db.Decimal(18, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([vehicleId, status])
}

model VehicleMaintenance {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  type        String
  description String
  scheduledAt DateTime?
  completedAt DateTime?
  cost        Decimal?  @db.Decimal(18, 2)
  odometer    Float?
  vendor      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vehicleId])
}

model FuelRecord {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  tripId        String?
  date          DateTime
  liters        Float
  pricePerLiter Decimal  @db.Decimal(18, 2)
  totalCost     Decimal  @db.Decimal(18, 2)
  odometer      Float?
  station       String?
  createdAt     DateTime @default(now())

  @@index([vehicleId, date])
}

model Supplier {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  nameTh           String?
  taxId            String?
  address          String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  isActive         Boolean           @default(true)
  isBlacklisted    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  rfqItems         RFQItem[]
}

model PurchaseRequisition {
  id             String          @id @default(cuid())
  refNo          String          @unique
  requesterId    String?
  projectId      String?
  siteId         String?
  urgency        String          @default("NORMAL")
  status         String          @default("DRAFT")
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          PRItem[]
  purchaseOrders PurchaseOrder[]
}

model PRItem {
  id             String              @id @default(cuid())
  prId           String
  pr             PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  itemId         String?
  item           InventoryItem?      @relation(fields: [itemId], references: [id])
  description    String
  quantity       Float
  unit           String
  estimatedPrice Decimal?            @db.Decimal(18, 2)
  createdAt      DateTime            @default(now())

  @@index([prId])
}

model RFQ {
  id        String    @id @default(cuid())
  refNo     String    @unique
  prId      String?
  title     String
  dueDate   DateTime?
  status    String    @default("OPEN")
  notes     String?
  createdAt DateTime  @default(now())
  items     RFQItem[]
}

model RFQItem {
  id          String   @id @default(cuid())
  rfqId       String
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  description String
  quantity    Float
  unit        String
  quotedPrice Decimal? @db.Decimal(18, 2)
  selected    Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([rfqId])
}

model PurchaseOrder {
  id               String               @id @default(cuid())
  refNo            String               @unique
  prId             String?
  pr               PurchaseRequisition? @relation(fields: [prId], references: [id])
  supplierId       String
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  projectId        String?
  status           String               @default("DRAFT")
  totalAmount      Decimal              @db.Decimal(18, 2)
  currency         String               @default("THB")
  deliveryDate     DateTime?
  approvedById     String?
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  items            POItem[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
}

model POItem {
  id          String         @id @default(cuid())
  poId        String
  po          PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  description String
  quantity    Float
  unit        String
  unitPrice   Decimal        @db.Decimal(18, 2)
  totalPrice  Decimal        @db.Decimal(18, 2)
  receivedQty Float          @default(0)

  @@index([poId])
}

model GoodsReceipt {
  id           String             @id @default(cuid())
  poId         String
  po           PurchaseOrder      @relation(fields: [poId], references: [id])
  refNo        String             @unique
  receivedAt   DateTime           @default(now())
  receivedById String?
  notes        String?
  createdAt    DateTime           @default(now())
  items        GoodsReceiptItem[]

  @@index([poId])
}

model GoodsReceiptItem {
  id          String         @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  description String
  quantity    Float
  unit        String
  condition   String         @default("GOOD")
  notes       String?

  @@index([receiptId])
}

model InventoryItem {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String
  nameTh        String?
  category      String?
  unit          String
  siteId        String?
  reorderPoint  Float?
  maxStock      Float?
  unitCost      Decimal            @default(0) @db.Decimal(18, 2)
  isActive      Boolean            @default(true)
  allowNegative Boolean            @default(false)
  stockBalance  Float              @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  movements     StockMovement[]
  prItems       PRItem[]
  poItems       POItem[]
  receiptItems  GoodsReceiptItem[]

  @@index([category])
}

model StockMovement {
  id           String        @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id])
  type         String
  quantity     Float
  unitCost     Decimal?      @db.Decimal(18, 2)
  totalCost    Decimal?      @db.Decimal(18, 2)
  balanceAfter Float
  sourceId     String?
  sourceType   String?
  notes        String?
  createdById  String?
  createdAt    DateTime      @default(now())

  @@index([itemId, createdAt])
}

model Asset {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  category         String
  serialNo         String?
  brand            String?
  model            String?
  purchaseDate     DateTime?
  purchaseCost     Decimal?           @db.Decimal(18, 2)
  currentValue     Decimal?           @db.Decimal(18, 2)
  depreciationRate Float?
  assignedToId     String?
  status           String             @default("ACTIVE")
  photoUrl         String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  maintenances     AssetMaintenance[]
  assignments      AssetAssignment[]
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id])
  employeeId String?
  siteId     String?
  projectId  String?
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  condition  String    @default("GOOD")
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([assetId])
}

model AssetMaintenance {
  id          String    @id @default(cuid())
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id])
  type        String
  description String
  scheduledAt DateTime?
  completedAt DateTime?
  cost        Decimal?  @db.Decimal(18, 2)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([assetId])
}

model Incident {
  id             String        @id @default(cuid())
  refNo          String        @unique
  siteId         String?
  projectId      String?
  reportedById   String?
  title          String
  description    String
  type           String
  severity       String
  status         String        @default("OPEN")
  occurredAt     DateTime
  location       String?
  injuryType     String?
  affectedPerson String?
  photoUrls      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  findings       QHSEFinding[]
}

model QHSEFinding {
  id             String    @id @default(cuid())
  incidentId     String?
  incident       Incident? @relation(fields: [incidentId], references: [id])
  siteId         String?
  description    String
  rootCause      String?
  actionRequired String?
  dueDate        DateTime?
  status         String    @default("OPEN")
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  capas          CAPA[]

  @@index([incidentId])
}

model CAPA {
  id           String       @id @default(cuid())
  findingId    String?
  finding      QHSEFinding? @relation(fields: [findingId], references: [id])
  refNo        String       @unique
  title        String
  description  String
  type         String       @default("CORRECTIVE")
  status       String       @default("OPEN")
  assignedToId String?
  dueDate      DateTime
  completedAt  DateTime?
  verifiedAt   DateTime?
  verifiedById String?
  evidenceUrls String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

model Risk {
  id          String    @id @default(cuid())
  projectId   String?
  siteId      String?
  title       String
  description String
  category    String
  likelihood  Int
  impact      Int
  riskScore   Int
  level       String
  owner       String?
  mitigation  String?
  status      String    @default("OPEN")
  reviewDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PermitToWork {
  id           String    @id @default(cuid())
  refNo        String    @unique
  siteId       String?
  projectId    String?
  type         String
  title        String
  description  String?
  contractor   String?
  location     String?
  startAt      DateTime
  endAt        DateTime
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([siteId, status])
}

model Invoice {
  id          String        @id @default(cuid())
  refNo       String        @unique
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  status      String        @default("DRAFT")
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  currency    String        @default("THB")
  subtotal    Decimal       @db.Decimal(18, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(18, 2)
  totalAmount Decimal       @db.Decimal(18, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(18, 2)
  notes       String?
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  receipts    Receipt[]

  @@index([clientId, status])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unit        String?
  unitPrice   Decimal @db.Decimal(18, 2)
  totalPrice  Decimal @db.Decimal(18, 2)
  taxRate     Float   @default(0)

  @@index([invoiceId])
}

model Receipt {
  id          String   @id @default(cuid())
  refNo       String   @unique
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  method      String   @default("BANK_TRANSFER")
  receivedAt  DateTime
  bankRefNo   String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model SupplierInvoice {
  id          String         @id @default(cuid())
  refNo       String         @unique
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  poId        String?
  po          PurchaseOrder? @relation(fields: [poId], references: [id])
  status      String         @default("DRAFT")
  invoiceDate DateTime
  dueDate     DateTime?
  totalAmount Decimal        @db.Decimal(18, 2)
  taxAmount   Decimal        @default(0) @db.Decimal(18, 2)
  paidAmount  Decimal        @default(0) @db.Decimal(18, 2)
  poMatched   Boolean        @default(false)
  grMatched   Boolean        @default(false)
  isVerified  Boolean        @default(false)
  notes       String?
  documentUrl String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  payments    Payment[]

  @@index([supplierId, status])
}

model Payment {
  id                String           @id @default(cuid())
  refNo             String           @unique
  supplierInvoiceId String?
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])
  amount            Decimal          @db.Decimal(18, 2)
  currency          String           @default("THB")
  method            String           @default("BANK_TRANSFER")
  scheduledAt       DateTime?
  paidAt            DateTime?
  bankRefNo         String?
  status            String           @default("PENDING")
  requestedById     String?
  approvedById      String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
}

model CashLedgerEntry {
  id           String    @id @default(cuid())
  entryDate    DateTime
  type         String
  direction    String
  amount       Decimal   @db.Decimal(18, 2)
  balance      Decimal   @db.Decimal(18, 2)
  currency     String    @default("THB")
  description  String
  sourceId     String?
  sourceType   String?
  bankAccount  String?
  bankRefNo    String?
  isReconciled Boolean   @default(false)
  reconciledAt DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([entryDate])
}

model Budget {
  id           String   @id @default(cuid())
  projectId    String?
  siteId       String?
  costCenterId String?
  period       String
  category     String
  budgetAmount Decimal  @db.Decimal(18, 2)
  actualAmount Decimal  @default(0) @db.Decimal(18, 2)
  committed    Decimal  @default(0) @db.Decimal(18, 2)
  forecast     Decimal  @default(0) @db.Decimal(18, 2)
  available    Decimal  @default(0) @db.Decimal(18, 2)
  controlMode  String   @default("WARNING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, period, category])
  @@index([period])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  actionUrl String?
  metadata  String?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
}

model WorkflowApproval {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  step       Int       @default(1)
  approverId String
  status     String    @default("PENDING")
  approvedAt DateTime?
  rejectedAt DateTime?
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([approverId, status])
}

model EventOutbox {
  id            String    @id @default(cuid())
  eventId       String    @unique
  eventType     String
  version       String    @default("1.0")
  correlationId String?
  payload       String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}

model AIActionProposal {
  id               String    @id @default(cuid())
  requestedById    String
  tool             String
  riskClass        String
  status           String    @default("DRAFT")
  inputPayload     String
  draftPayload     String?
  validationErrors String?
  reviewedById     String?
  reviewedAt       DateTime?
  executedAt       DateTime?
  rejectedAt       DateTime?
  rejectedReason   String?
  correlationId    String?
  auditTrail       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([requestedById])
}

model Document {
  id           String    @id @default(cuid())
  title        String
  type         String
  version      Int       @default(1)
  entityType   String?
  entityId     String?
  fileUrl      String
  fileHash     String?
  fileSize     Int?
  mimeType     String?
  isApproved   Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?
  isLatest     Boolean   @default(true)
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([entityType, entityId])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  type        String    @default("SECRET")
  scopes      Json
  allowedIps  Json
  tenantId    String?
  status      String    @default("ACTIVE")
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([status, expiresAt])
  @@index([tenantId])
}

model TrainingCourse {
  id          String               @id @default(cuid())
  title       String
  description String?
  hours       Int                  @default(1)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id             String         @id @default(cuid())
  courseId       String
  course         TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId     String
  status         String         @default("ASSIGNED")
  assignedAt     DateTime       @default(now())
  completedAt    DateTime?
  certificateUrl String?

  @@unique([courseId, employeeId])
  @@index([employeeId, status])
}

model ComplianceRecord {
  id          String    @id @default(cuid())
  title       String
  category    String
  status      String    @default("OPEN")
  ownerId     String?
  dueDate     DateTime?
  evidenceUrl String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, dueDate])
}

model SystemAlert {
  id           String    @id @default(cuid())
  severity     String
  type         String
  title        String
  message      String
  status       String    @default("OPEN")
  sourceType   String?
  sourceId     String?
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@index([status, severity, createdAt])
}
