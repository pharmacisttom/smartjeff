generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id           String   @id @default(cuid())
  code         String   @unique
  prefix       String?
  firstName    String
  lastName     String
  position     String
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  startDate    DateTime?
  birthDate    DateTime?
  gender       String   @default("MALE")
  nationality  String   @default("ไทย")
  idCardNo     String?  @unique
  phone        String?
  bankAccount  String?
  bankName     String?
  insurance    String?
  hospital     String?
  education    String?
  hometown     String?
  salaryType   String   @default("MONTHLY")
  baseSalary   Float    @default(12000)
  dailyRate    Float    @default(400)
  isActive     Boolean  @default(true)
  user         User?
  attendances  Attendance[]
  leaves       Leave[]
  payslips     Payslip[]
  chats        ChatMessage[]
  skills       EmployeeSkill[]
  planItems    WorkforcePlanItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId])
  @@index([code])
}

model Site {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  location    String?
  lat         Float?
  lng         Float?
  radius      Int     @default(200)
  workStart   Float   @default(7)
  workEnd     Float   @default(16)
  otStart     Float?  @default(16)
  otEnd       Float?  @default(17)
  minimumWorkforce Int? @default(1)
  targetWorkforce  Int? @default(1)
  maximumWorkforce Int?
  requiresSupervisor Boolean @default(false)
  employees   Employee[]
  config      PayrollConfig?
  workforceRequirements SiteWorkforceRequirement[]
  sourcePlans WorkforcePlan[] @relation("SourceSitePlans")
  targetPlans WorkforcePlan[] @relation("TargetSitePlans")
  createdAt   DateTime @default(now())
}

model Attendance {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  localId          String?  @unique       // idempotency key
  type             String   // CHECK_IN | CHECK_OUT | OT_IN | OT_OUT
  timestamp        DateTime @default(now())
  lat              Float
  lng              Float
  distance         Float
  accuracy         Float?
  isWithinGeofence Boolean  @default(false)
  photoUrl         String?
  photoHash        String?                 // SHA-256
  deviceInfo       String?
  note             String?
  isApproved       Boolean  @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@index([localId])
}

model Leave {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String   // SICK | PERSONAL | VACATION | OT
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId, status])
}

model Payslip {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      String                       // "2026-09"
  baseSalary  Float
  otHours     Float    @default(0)
  otAmount    Float    @default(0)
  travelAllow Float    @default(0)
  diligence   Float    @default(0)
  otherIncome Float    @default(0)
  tax         Float    @default(0)
  socialSec   Float    @default(0)
  otherDeduct Float    @default(0)
  netPay      Float
  pdfUrl      String?
  createdAt   DateTime @default(now())

  @@unique([employeeId, period])
  @@index([period])
}

model PayrollConfig {
  id                  String   @id @default(cuid())
  siteId              String?  @unique
  site                Site?    @relation(fields: [siteId], references: [id])
  otRate              Float    @default(75)
  travelAllowance     Float    @default(0)
  diligenceAmount     Float    @default(1000)
  diligenceMaxLate    Int      @default(3)
  workingDaysPerMonth Int      @default(26)
  workingHoursPerDay  Int      @default(8)
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
}

model ChatMessage {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String                       // user | assistant | admin
  content     String
  attachments String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String?
  role         String   @default("EMPLOYEE") // EMPLOYEE | ADMIN | HR
  lineUserId   String?  @unique
  image        String?
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model SiteWorkforceRequirement {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  position      String?
  minimum       Int       @default(1)
  target        Int       @default(1)
  maximum       Int?
  shift         String?   @default("DAY") // DAY | NIGHT
  dayOfWeek     Int?      // 0-6 or null
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([siteId, position])
}

model Skill {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  category    String?         // TECHNICAL | SAFETY | OPERATION | LEADERSHIP
  description String?
  employees   EmployeeSkill[]
  createdAt   DateTime        @default(now())
}

model EmployeeSkill {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      Int       @default(1) // 1 - 5
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, skillId])
  @@index([employeeId])
}

model WorkforcePlan {
  id           String              @id @default(cuid())
  planDate     DateTime
  sourceSiteId String
  sourceSite   Site                @relation("SourceSitePlans", fields: [sourceSiteId], references: [id])
  targetSiteId String
  targetSite   Site                @relation("TargetSitePlans", fields: [targetSiteId], references: [id])
  reason       String
  status       String              @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | CANCELLED | COMPLETED
  createdBy    String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        WorkforcePlanItem[]

  @@index([planDate, status])
}

model WorkforcePlanItem {
  id         String        @id @default(cuid())
  planId     String
  plan       WorkforcePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  position   String?
  note       String?
}
