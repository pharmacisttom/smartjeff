generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id           String   @id @default(cuid())
  code         String   @unique
  prefix       String?
  firstName    String
  lastName     String
  position     String
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  startDate    DateTime?
  birthDate    DateTime?
  gender       String   @default("MALE")
  nationality  String   @default("ไทย")
  idCardNo     String?
  phone        String?
  bankAccount  String?
  bankName     String?
  insurance    String?
  hospital     String?
  education    String?
  hometown     String?
  salaryType   String   @default("MONTHLY")
  baseSalary   Float    @default(12000)
  dailyRate    Float    @default(400)
  isActive     Boolean  @default(true)
  user         User?
  attendances  Attendance[]
  leaves       Leave[]
  payslips     Payslip[]
  chats        ChatMessage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId])
  @@index([code])
}

model Site {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  location     String?
  estateName   String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  lat          Float?
  lng          Float?
  radius       Int     @default(200)
  workStart    Float   @default(7)
  workEnd      Float   @default(16)
  otStart      Float?  @default(16)
  otEnd        Float?  @default(17)
  employees    Employee[]
  config       PayrollConfig?
  createdAt    DateTime @default(now())
}

model Attendance {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  localId          String?  @unique       // idempotency key
  type             String   // CHECK_IN | CHECK_OUT | OT_IN | OT_OUT
  timestamp        DateTime @default(now())
  lat              Float
  lng              Float
  distance         Float
  accuracy         Float?
  isWithinGeofence Boolean  @default(false)
  photoUrl         String?
  photoHash        String?                 // SHA-256
  deviceInfo       String?
  note             String?
  isApproved       Boolean  @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@index([localId])
}

model Leave {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String   // SICK | PERSONAL | VACATION | OT
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId, status])
}

model Payslip {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period        String                       // "2026-09"
  baseSalary    Float
  dailyRate     Float?   @default(0)
  workedDays    Int?     @default(0)
  dailyAmount   Float?   @default(0)
  otHours       Float    @default(0)
  otAmount      Float    @default(0)
  ot1Hours      Float?   @default(0)
  ot1Amount     Float?   @default(0)
  ot15Hours     Float?   @default(0)
  ot15Amount    Float?   @default(0)
  ot2Hours      Float?   @default(0)
  ot2Amount     Float?   @default(0)
  ot3Hours      Float?   @default(0)
  ot3Amount     Float?   @default(0)
  travelAllow   Float    @default(0)
  diligence     Float    @default(0)
  mealAllow     Float?   @default(0)
  otMealAllow   Float?   @default(0)
  heatAllow     Float?   @default(0)
  dishwashAllow Float?   @default(0)
  skillAllow    Float?   @default(0)
  incentive     Float?   @default(0)
  shiftAllow    Float?   @default(0)
  phoneAllow    Float?   @default(0)
  positionAllow Float?   @default(0)
  housingAllow  Float?   @default(0)
  coordAllow    Float?   @default(0)
  holidayPay    Float?   @default(0)
  leavePay      Float?   @default(0)
  otherIncome   Float    @default(0)
  grossIncome   Float?   @default(0)
  tax           Float    @default(0)
  socialSec     Float    @default(0)
  welfareDeduct Float?   @default(0)
  otherDeduct   Float    @default(0)
  totalDeduct   Float?   @default(0)
  netPay        Float
  pdfUrl        String?
  itemizedJson  String?
  createdAt     DateTime @default(now())

  @@unique([employeeId, period])
  @@index([period])
}

model PayrollConfig {
  id                  String   @id @default(cuid())
  siteId              String?  @unique
  site                Site?    @relation(fields: [siteId], references: [id])
  otRate              Float    @default(75)
  travelAllowance     Float    @default(0)
  diligenceAmount     Float    @default(1000)
  diligenceMaxLate    Int      @default(3)
  workingDaysPerMonth Int      @default(26)
  workingHoursPerDay  Int      @default(8)
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
}

model ChatMessage {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String                       // user | assistant | admin
  content     String
  attachments String?
  createdAt   DateTime @default(now())

  @@index([employeeId, createdAt])
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String?
  role             String   @default("EMPLOYEE") // EMPLOYEE | ADMIN | HR | SUPERVISOR
  permissions      String?  // ALL or comma-separated permissions
  assignedSiteCode String?  // For site supervisors
  lineUserId       String?  @unique
  image            String?
  employeeId       String?  @unique
  employee         Employee? @relation(fields: [employeeId], references: [id])
  createdAt        DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
