# ============================================================
# SmartJeff Enterprise — Production VPS Environment Config
# Instructions:
# 1. Copy this file to .env on your VPS: cp .env.production.example .env
# 2. Fill in real strong passwords and secrets (never commit .env to git)
# ============================================================

# ---- APPLICATION ----
APP_NAME="SmartJeff Enterprise"
APP_URL="https://your-domain.com"
APP_VERSION="1.0.0"
NODE_ENV="production"
PORT=3000
TZ="Asia/Bangkok"

# ---- DATABASE (MySQL 8 Production) ----
# Format for Docker: mysql://smartjeff:PASSWORD@mysql:3306/smartjeff
# Format for Native VPS: mysql://smartjeff:PASSWORD@127.0.0.1:3306/smartjeff
DATABASE_URL="mysql://smartjeff:CHANGE_THIS_DB_PASSWORD@127.0.0.1:3306/smartjeff"
MYSQL_ROOT_PASSWORD="CHANGE_THIS_MYSQL_ROOT_PASSWORD"
MYSQL_DATABASE="smartjeff"
MYSQL_USER="smartjeff"
MYSQL_PASSWORD="CHANGE_THIS_DB_PASSWORD"

# ---- AUTHENTICATION & SECRETS ----
# Generate via: openssl rand -base64 64
AUTH_SECRET="CHANGE_THIS_MINIMUM_64_CHARACTERS_SECURE_RANDOM_SECRET_KEY"
NEXTAUTH_URL="https://your-domain.com"
AUTH_TOKEN_EXPIRY=3600
AUTH_REFRESH_EXPIRY=604800
ENCRYPTION_KEY="CHANGE_THIS_64_HEX_CHARACTERS_KEY_FOR_SENSITIVE_DATA_ENCRYPTION"

# ---- DATA LOSS PREVENTION (DLP) & LOG INTEGRITY ----
# Secret key for HMAC-SHA256 cryptographic audit log chaining
DLP_HMAC_SECRET="CHANGE_THIS_DLP_HMAC_SECRET_KEY_FOR_CRYPTOGRAPHIC_CHAINING"

# ---- REDIS CACHE & SESSION STORE ----
# Format for Docker: redis://:PASSWORD@redis:6379/0
# Format for Native VPS: redis://:PASSWORD@127.0.0.1:6379/0
REDIS_URL="redis://:CHANGE_THIS_REDIS_PASSWORD@127.0.0.1:6379/0"
REDIS_PASSWORD="CHANGE_THIS_REDIS_PASSWORD"
CACHE_TTL_SECONDS=300

# ---- CLOUD STORAGE / S3 (Optional for off-site backups & photos) ----
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./public/uploads"
STORAGE_CDN_URL="https://your-domain.com/public/uploads"
