# ============================================================
# SmartJeff Enterprise Operations Platform v1.0
# Environment Configuration Template
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# ============================================================

# ---- APPLICATION ----
APP_NAME="SmartJeff Enterprise"
APP_URL="https://smartjeff.company-domain.com"
APP_VERSION="1.0.0"
NODE_ENV="production"
PORT=3000
TZ="Asia/Bangkok"

# ---- DATABASE (MySQL / MariaDB; credentials come from environment only) ----
DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/smartjeff"
DATABASE_URL_TEST="mysql://root:PASSWORD@127.0.0.1:3306/smartjeff_test"

# ---- AUTHENTICATION ----
# Generate: openssl rand -base64 64
AUTH_SECRET="CHANGE_ME_MINIMUM_64_CHAR_RANDOM_STRING"
AUTH_TOKEN_EXPIRY=3600
AUTH_REFRESH_EXPIRY=604800
ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARACTERS"

# ---- SESSION ----
SESSION_COOKIE_NAME="sj_session"
SESSION_SECURE=true
SESSION_SAME_SITE="strict"
SESSION_MAX_AGE=86400

# ---- MFA / TOTP ----
TOTP_ISSUER="SmartJeff"

# ---- REDIS ----
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379"
REDIS_DB=0
CACHE_TTL_SECONDS=300

# ---- OBJECT STORAGE (S3-compatible) ----
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="smartjeff-files-prod"
STORAGE_REGION="ap-southeast-1"
STORAGE_ACCESS_KEY="CHANGE_ME_ACCESS_KEY"
STORAGE_SECRET_KEY="CHANGE_ME_SECRET_KEY"
STORAGE_CDN_URL="https://cdn.company-domain.com"

# ---- EMAIL ----
EMAIL_API_URL="https://api.email-provider.example/send"
EMAIL_API_KEY="CHANGE_ME_EMAIL_API_KEY"
SMTP_HOST="smtp.company-domain.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@company-domain.com"
SMTP_PASSWORD="CHANGE_ME_EMAIL_PASSWORD"
EMAIL_FROM="SmartJeff <noreply@company-domain.com>"

# ---- PAYMENT ----
OMISE_SECRET_KEY="CHANGE_ME_OMISE_SECRET_KEY"

# ---- LOCAL FILE STORAGE (VPS persistent volume) ----
UPLOAD_DIR="/var/lib/smartjeff/uploads/attendance"

# ---- LICENSE ----
LICENSE_KEY="CHANGE_ME_LICENSE_KEY"
LICENSE_ACTIVATION_DATE="2026-01-01"
LICENSE_EXPIRY_DATE="2027-01-01"
LICENSE_MAX_EMPLOYEES=100
LICENSE_PLAN_NAME="Enterprise"

# ---- AI PROVIDER ----
AI_PROVIDER="openai"
OPENAI_API_KEY="CHANGE_ME_OPENAI_KEY"
OPENAI_MODEL="gpt-4o"
AI_MAX_TOKENS=4096
AI_KILL_SWITCH=false

# ---- WEBHOOK ----
WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_HMAC_SECRET"

# ---- MONITORING ----
LOG_LEVEL="info"
LOG_FORMAT="json"
METRICS_ENABLED=true
METRICS_PORT=9090

# ---- BACKUP ----
BACKUP_ENCRYPTION_KEY="CHANGE_ME_BACKUP_AES_KEY"
BACKUP_DESTINATION="s3"
BACKUP_BUCKET="smartjeff-backups-prod"
BACKUP_RETENTION_DAYS=30

# ---- SECURITY ----
RATE_LIMIT_LOGIN=5
RATE_LIMIT_MFA=3
RATE_LIMIT_API=100
CORS_ORIGIN="https://smartjeff.company-domain.com"

# ---- WORKERS ----
WORKER_CONCURRENCY=4
SCHEDULER_TIMEZONE="Asia/Bangkok"

# ---- FEATURE FLAGS ----
FEATURE_MFA_REQUIRED=true
FEATURE_DEVICE_TRUST=true
FEATURE_AI_COPILOT=true
FEATURE_SUPPLIER_PORTAL=true
FEATURE_CUSTOMER_PORTAL=true

# ---- NOTIFICATIONS ----
LINE_NOTIFY_TOKEN="CHANGE_ME_LINE_TOKEN"
TELEGRAM_BOT_TOKEN="CHANGE_ME_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="CHANGE_ME_TELEGRAM_CHAT_ID"
